{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "json",
  "rules": {
    "source_file": {
      "type": "SYMBOL",
      "name": "_value"
    },
    "_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "object"
        },
        {
          "type": "SYMBOL",
          "name": "array"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "false"
        },
        {
          "type": "SYMBOL",
          "name": "null"
        },
        {
          "type": "SYMBOL",
          "name": "true"
        }
      ]
    },
    "object": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_begin_object"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "member"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "_value_separator"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "member"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_end_object"
        }
      ]
    },
    "array": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_begin_array"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_value"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "_value_separator"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "_value"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_end_array"
        }
      ]
    },
    "null": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "null"
      }
    },
    "false": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "false"
      }
    },
    "true": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "true"
      }
    },
    "string": {
      "type": "SYMBOL",
      "name": "_literal_string"
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "-"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "0"
              },
              {
                "type": "PATTERN",
                "value": "[1-9][0-9]*"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "."
                  },
                  {
                    "type": "PATTERN",
                    "value": "[0-9]+"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[eE]"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "CHOICE",
                        "members": [
                          {
                            "type": "STRING",
                            "value": "-"
                          },
                          {
                            "type": "STRING",
                            "value": "+"
                          }
                        ]
                      },
                      {
                        "type": "BLANK"
                      }
                    ]
                  },
                  {
                    "type": "PATTERN",
                    "value": "[0-9]+"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "member": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "member_name"
        },
        {
          "type": "SYMBOL",
          "name": "_name_separator"
        },
        {
          "type": "SYMBOL",
          "name": "member_value"
        }
      ]
    },
    "member_name": {
      "type": "SYMBOL",
      "name": "_literal_string"
    },
    "member_value": {
      "type": "SYMBOL",
      "name": "_value"
    },
    "_begin_array": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "["
      }
    },
    "_begin_object": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "{"
      }
    },
    "_end_array": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "]"
      }
    },
    "_end_object": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "}"
      }
    },
    "_name_separator": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": ":"
      }
    },
    "_value_separator": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": ","
      }
    },
    "_literal_string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\\\x00-\\x1F]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\[\"\\\\/bfnrt]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\u[0-9a-fA-F]{4}"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}